{
  "name": "cy.tests.demo",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@simonsmith/cypress-image-snapshot": "^11.0.0",
    "cypress": "^16.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-cypress": "^7.0.1",
    "globals": "^17.8.0",
    "mocha": "^12.0.0",
    "mochawesome": "8.0.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "yarn": "^1.22.22"
  },
  "scripts": {
    "cy:run": "cypress run --browser chrome",
    "cleanup": "rm -rf report",
    "merge:report": "mochawesome-merge report/mochawesome-report/*.json > report/mochawesome-report/cypress_report.json",
    "generate:html": "marge -o report report/mochawesome-report/cypress_report.json",
    "lint": " npx eslint . --fix"
  }
}
